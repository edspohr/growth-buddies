{
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "public",
    "predeploy": [
      "npm run build"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800"
          }
        ]
      },
      {
        "source": "**/*.@(css|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400, stale-while-revalidate=604800"
          }
        ]
      },
      {
        "source": "**/*.@(webp|mp4|webm|png|jpg|jpeg|svg)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/fonts/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/recursos/glosario-ia-automatizacion",
        "destination": "/preguntas-frecuentes",
        "type": 301
      },
      {
        "source": "/servicios",
        "destination": "/#productos",
        "type": 301
      },
      {
        "source": "/servicios/ia-corporativa",
        "destination": "/agent-buddy",
        "type": 301
      },
      {
        "source": "/servicios/legal-tech",
        "destination": "/docflow-buddy/estudios-juridicos",
        "type": 301
      },
      {
        "source": "/servicios/gestion-del-cambio",
        "destination": "/metodologia",
        "type": 301
      },
      {
        "source": "/soluciones",
        "destination": "/casos",
        "type": 301
      },
      {
        "source": "/sectores",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/sectores/automatizacion-ia-estudios-juridicos",
        "destination": "/docflow-buddy/estudios-juridicos",
        "type": 301
      },
      {
        "source": "/sectores/automatizacion-ia-industria-mineria",
        "destination": "/expense-buddy/mineria-y-faena",
        "type": 301
      },
      {
        "source": "/blog/automatizacion-contratos-legales-2026",
        "destination": "/docflow-buddy/estudios-juridicos",
        "type": 301
      },
      {
        "source": "/blog/ia-para-revisar-contratos-legales",
